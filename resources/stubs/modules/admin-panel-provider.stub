<?php

namespace $MODULE_NAMESPACE$\$STUDLY_NAME$\Providers\Filament;

use App\Contracts\Addons\AddonServiceProvider;
use Filament\Panel;
use Filament\Support\Colors\Color;
use Override;

/**
 * Declares the $STUDLY_NAME$ admin panel. The panel arrives with the module
 * defaults: the `admin/{key}` path (the key is the manifest alias), the console
 * chrome, discovery of Filament/{Resources,Pages,Widgets} and the addon settings
 * page. Change it here, or move this method into the addon's main provider.
 */
class AdminPanelProvider extends AddonServiceProvider
{
    #[Override]
    public function registerAdminFilamentPanel(Panel $panel): Panel
    {
        return $panel->colors([
            'primary' => Color::Teal,
        ]);
    }
}
