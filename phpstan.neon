includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    # Teaches PHPStan the Pest functional API (it/test/expect, $this in closures).
    # Registered explicitly because phpstan/extension-installer is not installed.
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:

    paths:
        - app/
        - tests/

    # modules/ is deliberately not scanned. It once indexed module symbols so
    # tests resolved against the real class, but two entries there are symlinks
    # to full external checkouts (phpvms-acars -> acars-plugin, phpvms-vacentral)
    # and PHPStan followed them into node_modules/ and vendor/. The resulting
    # symbol cache reached 746 MB, which no run could load back -- every
    # invocation died on its own cache at 4G before analysing a single file.
    # Dropping it cost nothing measurable: a full run reports the same errors
    # with and without the scan, and the `Modules\Sample` ignore below was
    # already unmatched either way.

    # Level 10 is the highest level
    level: 5

    ignoreErrors:

        # PHPStan is not able to understand the pivot attributes at the moment
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Relations\\Pivot::\$[a-zA-Z_]+#'

        # The other half of the same gap: `pivot` itself, which Eloquent attaches
        # to BelongsToMany results at runtime, so it has no declaration to
        # resolve against. The entry above covers properties *on* the pivot
        # object; this covers the property that holds it.
        - identifier: property.notFound
          message: '#Access to an undefined property App\\Models\\[A-Za-z]+::\$pivot#'

        # MorphTo, Model::resolveRouteBinding() and Filament's
        # InteractsWithRecord::getRecord() all return the base Model by design;
        # the concrete type is only known at runtime.
        - identifier: property.notFound
          message: '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$[a-zA-Z_]+#'

        # FilesTrait::files() defines a morphMany via traits — larastan's relationExistence
        # rule can't statically resolve trait-defined polymorphic relations even though they
        # work at runtime. Models using FilesTrait: Aircraft, Airline, Airport, Subfleet.
        - identifier: larastan.relationExistence
          message: '#Relation ''files'' is not found in App\\Models\\(Aircraft|Airline|Airport|Subfleet) model\.#'

        # ── tests/ only ────────────────────────────────────────────────────────
        # Each entry below is a static-analysis blind spot, not a defect. Real
        # findings were fixed at the source rather than listed here.

        # Filament registers its table and form assertions as runtime macros on
        # Livewire's Testable, so they have no declaration to resolve against.
        # Testable carries `@mixin \Illuminate\Testing\TestResponse`, which is why
        # the message names TestResponse rather than Testable.
        # Listed by name on purpose: a broad `TestResponse::` pattern would also
        # swallow genuine typos.
        - identifier: method.notFound
          message: '#Call to an undefined method Illuminate\\Testing\\TestResponse::(assertCanSeeTableRecords|assertCanRenderTableColumn|assertCanNotRenderTableColumn|assertFormExists|assertFormFieldExists|assertFormFieldDoesNotExist|assertActionExists)\(\)#'
          path: tests/

        # set() and assertSet() are real Testable methods. They only fail to resolve
        # because the chain reaches them through the TestResponse mixin above:
        # `Livewire::test(...)->assertSuccessful()` returns TestResponse, so every
        # later link in that chain is typed against TestResponse instead of Testable.
        # Reordering the chains would silence this, but at the cost of contorting
        # readable tests to suit the analyser.
        - identifier: method.notFound
          message: '#Call to an undefined method Illuminate\\Testing\\TestResponse::(set|assertSet)\(\)#'
          path: tests/

        # Facade spies. These exist on the underlying Mockery spy, not on the
        # facade's static surface.
        - identifier: staticMethod.notFound
          message: '#Call to an undefined static method Illuminate\\Support\\Facades\\Log::(shouldHaveReceived|shouldNotHaveReceived)\(\)#'
          path: tests/

        # shouldReceive() is typed as returning the union of Mockery's own
        # interfaces, so every later link in an expectation chain is checked
        # against that union rather than against Expectation, which is what
        # actually carries these. Named individually so a typo still reports.
        - identifier: method.notFound
          message: '#Call to an undefined method Mockery\\ExpectationInterface\|Mockery\\HigherOrderMessage::(once|andThrow)\(\)#'
          path: tests/

        # Pest's test() helper is typed as the union it can return outside a
        # test closure; mock() lives on the TestCase that `test()` proxies to.
        # Used by helper functions, which have no $this to call it on.
        - identifier: method.notFound
          message: '#Call to an undefined method Pest\\PendingCalls\\TestCall\|Pest\\Support\\HigherOrderTapProxy::mock\(\)#'
          path: tests/

        # Mockery's stub types andReturns() as taking no arguments, though it is
        # variadic in practice.
        - identifier: arguments.count
          message: '#Method Mockery\\ExpectationInterface::andReturns\(\) invoked with 1 parameter, 0 required\.#'
          path: tests/

        # A Mockery mock is typed as the union of Mockery's own interfaces rather
        # than as the class it doubles, so passing one where the real interface is
        # expected cannot be checked. Named per call site so a mock handed to the
        # wrong parameter is still reported.
        - identifier: argument.type
          message: '#\$clientEntity of method App\\Auth\\ScopeRepository::finalizeScopes\(\) expects League\\OAuth2\\Server\\Entities\\ClientEntityInterface, Mockery\\MockInterface given#'
          path: tests/

        # Same union, read side: these are properties of the access-token double.
        - identifier: property.notFound
          message: '#Access to an undefined property Mockery\\ExpectationInterface\|Mockery\\HigherOrderMessage\|Mockery\\MockInterface::\$(token|refreshToken|expiresIn)#'
          path: tests/

        # The sample addon is not tracked (modules/.gitignore ignores every addon
        # directory), so a fresh clone or CI checkout has no Modules\Sample at all.
        # The tests that drive it already guard with ->skip(sampleAddonMissing(...)).
        - identifier: class.notFound
          message: '#Modules\\Sample#'
          path: tests/

        # App\Enums\PirepStatus is a deprecated class_alias onto PirepPhase, created
        # at runtime, so no amount of static analysis can see it. A stub was rejected:
        # it would duplicate all 25 enum cases with no way to catch drift, since at
        # runtime the two names are literally the same class.
        - message: '#App\\Enums\\PirepStatus#'
          path: tests/Feature/PirepPhaseEnumTest.php

        # Pest's arch expectations are built through a fluent proxy whose properties
        # (->classes, ->not, ...) are resolved dynamically.
        - identifier: property.notFound
          message: '#Pest\\(Arch\\Contracts\\ArchExpectation|PendingCalls\\TestCall|Support\\HigherOrderTapProxy)#'
          path: tests/

        # appIsBooted() exists precisely because these instanceof checks are not
        # always true at runtime: Pest's Tia engine reaches afterEach with app()
        # as a bare Container, or as an Application whose bindings have been
        # flushed so app('config') returns the Config facade. Static analysis
        # sees only the declared return types and calls both checks redundant.
        - identifier: instanceof.alwaysTrue
          path: tests/Helpers/AppHelpers.php

        # The acme addon fixture under tests/fixtures/ registers its view namespace
        # and helper file at runtime when the test boots it, so neither the
        # `acme::` view namespace nor its helper functions exist statically.
        - identifier: method.impossibleType
          message: '#View\\Factory::exists\(\) with ''acme::#'
          path: tests/Feature/Addons/BaseAddonServiceProviderTest.php
        - identifier: function.notFound
          message: '#Function sample_module_greeting not found#'
          path: tests/Feature/Addons/SampleModuleHelpersTest.php

        # FAKE_MODULE_PAGE deliberately names a class that does not exist -- the
        # test asserts a panel registering an unresolvable module page stays safe.
        # A real class-string would defeat the point of the test.
        - identifier: argument.type
          message: '#\$pages of method Filament\\Panel::pages\(\)#'
          path: tests/Feature/Permissions/ModulePanelAccessTest.php

        # Pest declares `expect()` as `@param TValue|null $value`. When the argument
        # is itself a complex generic, unifying TValue against that nullable
        # parameter reports the type as incompatible with itself -- the message
        # reads "expects Collection<...>|null, Collection<...> given". A quirk of
        # Pest's own signature, not of the calling code.
        - identifier: argument.type
          message: '#\$value of function expect expects Illuminate\\Support\\Collection#'
          path: tests/

        # A "redundant" expectation is one static analysis can already prove, which
        # is a style opinion rather than a defect: the proof comes from docblocks,
        # and this very change corrected several that were wrong. Deleting working
        # runtime assertions to satisfy it would trade real safety for tidiness.
        # pest.expectation.impossible stays enabled -- that one catches real bugs.
        - identifier: pest.expectation.redundant
          path: tests/

        # Filament registers page actions dynamically, so `$this->editAction`
        # resolves the page's `editAction()` method through __get. The overview
        # component takes the action as a property (never a method call), which
        # is the documented convention -- there is no declaration to see.
        - identifier: property.notFound
          message: '#Access to an undefined property App\\Filament\\Resources\\.*::\$editAction#'

        # Livewire test helpers. `livewire()` is typed as the base Component, so
        # Filament's schema/action accessors on the concrete page are invisible,
        # and TestResponse gains its Filament assertions via macros.
        - identifier: method.notFound
          message: '#Call to an undefined method Livewire\\Component::(getSchema|getMountedAction|getMountedActionSchemaName)\(\)#'
          path: tests/
        - identifier: method.notFound
          message: '#Call to an undefined method Illuminate\\Testing\\TestResponse::(html|instance|assert[A-Za-z]+)\(\)#'
          path: tests/

        # Mockery's fluent API returns a union whose members do not all declare
        # every expectation method, and Invader is intentionally untyped -- it
        # exists to reach private members.
        - identifier: method.notFound
          message: '#Call to an undefined method Mockery\\ExpectationInterface\|Mockery\\HigherOrderMessage::#'
          path: tests/
        - identifier: method.notFound
          message: '#Call to an undefined method Spatie\\Invade\\Invader#'
          path: tests/

        # The query builder hands constraint callbacks the base Constraint; the
        # concrete subclass carrying isInteger()/getOptions()/isNullable() is
        # only known at runtime from the constraint that was registered.
        - identifier: method.notFound
          message: '#Call to an undefined method Filament\\QueryBuilder\\Constraints\\Constraint::#'

        # Theme::exists() is re-checked after rebuildCache()/scanThemes(), which
        # is the entire point: the first call can be false purely because the
        # cached theme list is stale. PHPStan treats the facade as pure and so
        # believes the second check can never differ from the first.
        - identifier: if.alwaysFalse
          path: app/Http/Middleware/SetActiveTheme.php

        # ReversePrimaryButtons falls back to parent::getFormContentComponent()
        # when a form has no top-level Section. That parent exists on EditRecord
        # and CreateRecord, which is what the trait was written for, but not on a
        # plain Filament\Pages\Page -- and Branding is the first plain page to
        # use it. Unreachable there in practice: the house admin page format
        # requires one outer Section card, so lastFormSection() always resolves.
        # A plain page adopting this trait must keep that outer Section.
        - identifier: staticMethod.notFound
          message: '#Call to an undefined static method Filament\\Pages\\Page(<[^>]+>)?::getFormContentComponent\(\)#'
          path: app/Filament/Concerns/ReversePrimaryButtons.php

        # Every model using HasAssets today (Award, Rank, FlightBundle) also uses
        # SoftDeletes, so PHPStan can prove the guard always passes. It is
        # defensive on purpose: the trait has to stay correct on a model that
        # does not soft-delete, where isForceDeleting() does not exist and the
        # asset should be cleaned up on any delete. Dropping the guard would
        # destroy the badge of a soft-deleted record an admin later restores.
        # (Reported once per using class, test fixtures included, so the class
        # is not named -- the path is what keeps this narrow.)
        - identifier: function.alreadyNarrowedType
          message: '#method_exists\(\) with .+ and ''isForceDeleting''#'
          path: app/Traits/HasAssets.php
