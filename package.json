{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:components": "node bin/build.js --dev",
    "build": "pnpm run build:admin && pnpm run build:fe",
    "build:admin": "vite build && node bin/build.js",
    "build:fe": "pnpm --filter @phpvms/skylight run build",
    "build:components": "node bin/build.js",
    "clean": "rm -rf public/build resources/js/dist",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check . '!**/*.json'",
    "fmt:check:json": "oxfmt --list-different '**/*.json'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "safelist:check": "node bin/measure-tailwind-safelist.mjs"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@phpvms/map": "workspace:*",
    "@preact/signals": "^2.11.3",
    "axios": "^1.20.0",
    "bootstrap": "~4.6.2",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "cookieconsent": "^3.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "jquery": "^3.7.1",
    "leaflet": "^1.9.4",
    "leaflet-providers": "^2.0.0",
    "leaflet-rotatedmarker": "^0.2.0",
    "leaflet.geodesic": "^2.7.2",
    "moment": "^2.31.0",
    "popper.js": "^1.16.1",
    "preact": "^10.29.8",
    "rivets": "^0.9.6",
    "select2": "^4.1.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.9",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.0",
    "laravel-vite-plugin": "^3.2.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.89.0",
    "sass": "^1.105.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@11.9.0"
}
